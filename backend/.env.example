# ===========================
# m2smart Backend Configuration
# ===========================

# Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://m2smart:m2smart_password@localhost:5432/m2smart?schema=public
TIMESCALE_DB_URL=postgresql://m2smart:m2smart_password@localhost:5432/m2smart_timeseries?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_WS_PORT=9001
MQTT_USERNAME=m2smart_server
MQTT_PASSWORD=mqtt-server-password-change-in-production
MQTT_USE_TLS=false

# SMS Provider (Faraz SMS or other)
SMS_PROVIDER=farazsms
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=m2smart

# Call Provider (if different from SMS)
CALL_PROVIDER=your-provider
CALL_API_KEY=your-call-api-key

# Email (for notifications and verification)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@m2smart.com
SMTP_PASSWORD=smtp-password

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=60000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=60000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Emergency Alert Throttling
EMERGENCY_SMS_MAX_PER_HOUR=3
EMERGENCY_CALL_MAX_PER_HOUR=3
EMERGENCY_COOLDOWN_MINUTES=5

# Data Retention (days)
TELEMETRY_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730
EVENTS_RETENTION_DAYS=365
